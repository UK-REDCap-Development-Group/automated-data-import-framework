{
    "name": "Automated Data Import Framework",
    "description": "The Automated Data Import Framework (hereafter referred to as ADIF), is an expansible and generalized wrapper for API accessible data sources, as well as a docker setup that should make setting flatfiles up as API sources a breeze.",
    "namespace": "UKModules\\ADIF",
    "framework-version": 15,
    "authors": [
        {
            "name": "Noah Perry",
            "email": "noah.perry@uky.edu",
            "institution": "University of Kentucky CCTS"
        }
    ],
    "system-settings": [
        {
            "key": "adif-cache-enabled",
            "name": "<b>API caching:</b> enable caching of API responses. Projects then choose which of their API sources to cache. When unchecked, nothing is cached on this server: every request goes to the API, whatever projects have chosen.",
            "type": "checkbox"
        },
        {
            "key": "adif-cache-max-scope",
            "name": "Widest sharing allowed for cached API responses",
            "type": "dropdown",
            "choices": [
                {
                    "value": "system",
                    "name": "Across projects, for public data from keyless sources (default)"
                },
                {
                    "value": "project",
                    "name": "Within a project only"
                },
                {
                    "value": "record",
                    "name": "Within a record only"
                }
            ]
        },
        {
            "key": "adif-table-max-file-mb",
            "name": "<b>Data tables:</b> largest file a project can upload, in MB. Leave blank for the default of 8 MB. The server's PHP upload limits still apply when they're lower.",
            "type": "text",
            "validation": "number"
        },
        {
            "key": "adif-table-max-project-mb",
            "name": "Most storage one project can use in total, in MB: its uploaded data tables and its cached API responses together. Leave blank for the default of 32 MB. Reaching it only blocks new uploads (caching carries on); lowering it doesn't remove anything already stored.",
            "type": "text",
            "validation": "number"
        },
        {
            "key": "adif-cleanup-frequency",
            "name": "<b>Deleted projects:</b> how often ADIF removes what it kept for deleted projects: their cached API responses once a project is deleted, and their uploaded tables, ADIF settings and ADIF log entries once REDCap deletes it permanently. Leave blank for the default, weekly.",
            "type": "dropdown",
            "choices": [
                {
                    "value": "weekly",
                    "name": "Weekly (default)"
                },
                {
                    "value": "daily",
                    "name": "Daily"
                },
                {
                    "value": "off",
                    "name": "Never: leave it for an administrator to remove"
                }
            ]
        },
        {
            "key": "adif-cleanup-weekday",
            "name": "Day it runs on, when weekly. Leave blank for the default, Thursday.",
