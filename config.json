{
    "name": "Automated Data Import Framework",
    "description": "The Automated Data Import Framework (hereafter referred to as ADIF), is an expansible and generalized wrapper for API accessible data sources, as well as a docker setup that should make setting flatfiles up as API sources a breeze.",
    "namespace": "UKModules\\ADIF",
    "framework-version": 15,
    "authors": [
        {
            "name": "Noah Perry",
            "email": "noah.perry@uky.edu",
            "institution": "University of Kentucky CCTS"
        }
    ],
    "system-settings": [
        {
            "key": "adif-section-caching",
            "type": "descriptive",
            "name": "<span style=\"display: block; font-size: 1.15em; font-weight: bold; border-bottom: 1px solid #ccc; padding-bottom: 3px; margin-top: 10px;\">API caching</span><span style=\"display: block; color: #555; margin-top: 4px;\">Saves API responses so a repeated request doesn't go to the API again. Each project chooses which of its API sources to cache; these settings cover the whole server.</span>"
        },
        {
            "key": "adif-cache-enabled",
            "name": "Allow caching on this server (unchecked: nothing is cached, whatever projects choose)",
            "type": "checkbox"
        },
        {
            "key": "adif-cache-max-scope",
            "name": "Widest sharing of cached responses",
            "type": "dropdown",
            "choices": [
                {
                    "value": "system",
                    "name": "Across projects, for public data from keyless sources (default)"
                },
                {
                    "value": "project",
                    "name": "Within a project only"
                },
                {
                    "value": "record",
                    "name": "Within a record only"
                }
            ],
            "branchingLogic": {
                "field": "adif-cache-enabled",
                "value": true
            }
        },
        {
            "key": "adif-section-tables",
            "type": "descriptive",
            "name": "<span style=\"display: block; font-size: 1.15em; font-weight: bold; border-bottom: 1px solid #ccc; padding-bottom: 3px; margin-top: 10px;\">Uploaded data tables</span><span style=\"display: block; color: #555; margin-top: 4px;\">Files projects upload on their Data Sources page and use like an API. A project's storage holds its uploaded tables and its cached API responses together: when it's full, new uploads are refused but caching carries on, and lowering the limit removes nothing already stored.</span>"
        },
        {
            "key": "adif-php-upload-limits",
            "name": "<span style=\"display: block; color: #555;\">This server's PHP upload limits (upload_max_filesize and post_max_size) also cap the sizes below. Their values are shown here in REDCap 11 or later.</span>",
            "type": "descriptive"
        },
        {
            "key": "adif-table-max-file-mb",
            "name": "Largest file per upload, in MB (blank: 8)",
            "type": "text",
            "validation": "number",
            "validation_min": "1"
        },
        {
            "key": "adif-table-max-project-mb",
            "name": "Storage per project, in MB (blank: 32)",
            "type": "text",
            "validation": "number",
            "validation_min": "1"
        },
        {
            "key": "adif-section-imports",
            "type": "descriptive",
            "name": "<span style=\"display: block; font-size: 1.15em; font-weight: bold; border-bottom: 1px solid #ccc; padding-bottom: 3px; margin-top: 10px;\">Background imports</span><span style=\"display: block; color: #555; margin-top: 4px;\">Imports ADIF runs on its own: survey and data entry imports from the queue, Refresh all records, and Retry all failed. Imports started on the Import Status page, or run while a respondent waits, aren't limited. Each import sends one request per API endpoint its mappings read from. Refresh all records waits for off-peak hours; choose the same hour for both to let it run at any time.</span>"
        },
        {
            "key": "adif-imports-per-minute",
            "name": "Most background imports per minute, server-wide (blank: 20)",
            "type": "text",
            "validation": "integer",
            "validation_min": "1",
            "validation_max": "300"
        },
