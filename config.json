            {
                "name": "ADIF Import Status",
                "icon": "fa-clipboard-list",
                "url": "pages/Imports.php",
                "show-header": true
            }
        ]
    },
    "project-settings": [
        {
            "key": "api-sources",
            "name": "Input the base URLs of any APIs which you would like to make available to your project.",
            "type": "sub_settings",
            "repeatable": true,
            "sub_settings": [
                {
                    "key": "api",
                    "name": "URL",
                    "type": "text"
                },
                {
                    "key": "schema-probe",
                    "name": "Endpoint to check for a schema (optional). It's added to the URL above the same way a field's path is, and can use [field_name] placeholders, e.g. <code>cwsq-ngmh.json?locationid=[census_tract_geoid]</code>",
                    "type": "text"
                },
                {
                    "key": "schema",
                    "name": "Please provide the API schema, or use <b>Detect schema</b> to read it from the API.",
                    "type": "json"
                },
                {
                    "key": "response-table",
                    "name": "<b>Responses are tables:</b> a list of rows whose first row names the columns, as the Census API returns. ADIF reads each later row as a record named by those columns, so a value is mapped as <code>[0].B19013_001E</code> rather than by position (<code>[1][7]</code>).",
                    "type": "checkbox"
                },
                {
                    "key": "api-key",
                    "name": "If this source needs an API key, input it here.",
                    "type": "password"
                },
                {
                    "key": "api-key-location",
                    "name": "Where this API expects the key",
                    "type": "dropdown",
                    "choices": [
                        { "value": "bearer", "name": "In an Authorization: Bearer header (default)" },
                        { "value": "header", "name": "In a request header with the name below" },
                        { "value": "query", "name": "As a query parameter with the name below" }
                    ]
                },
                {
                    "key": "api-key-name",
                    "name": "Header or query parameter name for the key, e.g. <code>key</code> or <code>X-API-Key</code>",
                    "type": "text",
                    "branchingLogic": {
                        "type": "or",
                        "conditions": [
                            { "field": "api-key-location", "value": "header" },
                            { "field": "api-key-location", "value": "query" }
                        ]
                    }
                },
                {
                    "key": "cache-enabled",
                    "name": "<b>Caching:</b> cache this API's responses. Each response is stored as imports request it, and identical requests reuse it instead of calling the API again. Has no effect if API caching is turned off for this server. The settings below apply only to cached sources.",
                    "type": "checkbox"
                },
                {
                    "key": "cache-mode",
                    "name": "When should ADIF call this API?",
                    "type": "dropdown",
                    "choices": [
                        {
                            "value": "cache_first",
                            "name": "Only for data not already stored (default)"
                        },
                        {
                            "value": "refresh_if_stale",
                            "name": "When stored data is older than a set number of days"
                        },
                        {
                            "value": "offline",
                            "name": "Never: use stored data only"
                        }
                    ]
                },
                {
                    "key": "cache-max-age-days",
                    "name": "Refresh stored data older than this many days",
                    "type": "text",
                    "validation": "integer",
                    "branchingLogic": {
                        "field": "cache-mode",
                        "value": "refresh_if_stale"
                    }
                },
                {
                    "key": "cache-on-failure",
                    "name": "If this API is unavailable",
                    "type": "dropdown",
                    "choices": [
                        {
                            "value": "use_stale",
                            "name": "Use the last stored value and note it in the module log (default)"
                        },
                        {
                            "value": "fail",
                            "name": "Leave the fields blank and log an error"
                        }
                    ]
                },
                {
                    "key": "data-version",
                    "name": "Data version (optional), e.g. <code>2023</code>. Changing it makes ADIF fetch fresh data instead of reusing data stored under the old version. Recommended for versioned data such as ACS releases.",
                    "type": "text"
                },
                {
                    "key": "lookups-are-public",
                    "name": "The record values piped into this source's [placeholders] are public codes (e.g. census tract IDs), not identifying information such as addresses. Leave unchecked if unsure: identifying requests are cached only within this project, under one-way hashed keys.",
                    "type": "checkbox"
                },
                {
                    "key": "cache-scope",
                    "name": "Share stored responses",
                    "type": "dropdown",
                    "choices": [
                        {
                            "value": "project",
                            "name": "Across records in this project (default)"
                        },
                        {
                            "value": "record",
                            "name": "Only within the same record"
                        },
                        {
                            "value": "system",
                            "name": "With other projects on this server (public, keyless sources only)"
                        }
                    ]
                }
            ]
        },
        {
            "key": "import-immediately",
            "name": "<b>Imports:</b> run each import while the survey respondent waits, before their completion page appears. Leave unchecked (recommended) to run imports in the background, usually within a minute or two of submission, so a slow or unavailable API never holds up respondents. Check this only if a later survey needs to show imported values straight away.",
            "type": "checkbox"
        },
        {
            "key": "data-entry-imports",
            "name": "<b>Data entry:</b> surveys import automatically when they're completed. After a data entry form that ADIF imports into, or reads a lookup value from, is saved, should ADIF ask whether to import? Users who can resolve imports are asked; the import replaces the mapped fields' current values.",
            "type": "dropdown",
            "choices": [
                {"value": "ask", "name": "Ask after each save (default)"},
                {"value": "off", "name": "Don't ask: data entry saves never import"}
            ]
        },
        {
            "key": "show-api-test-page",
            "name": "Show the API Test page in the project menu?",
            "type": "checkbox"
        }
    ]
}
