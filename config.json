{
    "name": "Automated Data Import Framework",
    "description": "The Automated Data Import Framework (hereafter referred to as ADIF), is an expansible and generalized wrapper for API accessible data sources, as well as a docker setup that should make setting flatfiles up as API sources a breeze.",
    "namespace": "UKModules\\ADIF",
    "framework-version": 15,
    "authors": [
        {
            "name": "Noah Perry",
            "email": "noah.perry@uky.edu",
            "institution": "University of Kentucky CCTS"
        }
    ],
    "system-settings": [],
    "links": {
        "project": [
            {
                "name": "ADIF: API Test",
                "icon": "gear",
                "url": "pages/API_Test.php",
                "show-header": true,
                "show-user-setting": "show-api-test-page"
            }
        ]
    },
    "project-settings": [
        {
            "key": "api-sources",
            "name": "Input the base URLs of any APIs which you would like to make available to your project.",
            "type": "sub_settings",
            "repeatable": true,
            "sub_settings": [
                {
                    "key": "api",
                    "name": "URL",
                    "type": "text"
                },
                {
                    "key": "schema",
                    "name": "Please provide the API schema.",
                    "type": "json"
                },
                {
                    "key": "api-key",
                    "name": "If this source needs an API key, input it here.",
                    "type": "password"
                }
            ]
        },
        {
            "key": "show-api-test-page",
            "name": "Show the API Test page in the project menu?",
            "type": "checkbox"
        }
    ]
}
