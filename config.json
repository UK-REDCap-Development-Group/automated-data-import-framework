    "auth-ajax-actions": [
        "detect-schema",
        "retry-import",
        "dismiss-import",
        "import-unattempted",
        "run-import-queue"
    ],
    "crons": [
        {
            "cron_name": "adif_import_queue",
            "cron_description": "ADIF: runs the API imports queued after survey submissions",
            "method": "processImportQueue",
            "cron_frequency": "60",
            "cron_max_run_time": "600"
        },
        {
            "cron_name": "adif_deleted_project_cleanup",
            "cron_description": "ADIF: checks hourly whether the deleted-project cleanup is due (it runs on the schedule set in ADIF's system settings, weekly by default)",
            "method": "cleanUpDeletedProjects",
            "cron_frequency": "3600",
            "cron_max_run_time": "1800"
        },
        {
            "cron_name": "adif_import_refresh",
            "cron_description": "ADIF: works through the bulk import refreshes requested on projects' Import Status pages, during the off-peak hours set in the module's system settings",
            "method": "processImportRefreshJobs",
            "cron_frequency": "60",
            "cron_max_run_time": "600"
        }
    ],
