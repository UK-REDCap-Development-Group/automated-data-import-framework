        {
            "key": "adif-section-cleanup",
            "type": "descriptive",
            "name": "<span style=\"display: block; font-size: 1.15em; font-weight: bold; border-bottom: 1px solid #ccc; padding-bottom: 3px; margin-top: 10px;\">Cleanup after projects are deleted</span><span style=\"display: block; color: #555; margin-top: 4px;\">Removes what ADIF kept for a deleted project: its cached API responses as soon as it's deleted, and its uploaded tables, ADIF settings and ADIF log entries once REDCap deletes it permanently. It starts within the chosen hour (server time), when REDCap's cron next runs.</span>"
        },
        {
            "key": "adif-cleanup-frequency",
            "name": "How often",
            "type": "dropdown",
            "choices": [
                {
                    "value": "weekly",
                    "name": "Weekly (default)"
                },
                {
                    "value": "daily",
                    "name": "Daily"
                },
                {
                    "value": "off",
                    "name": "Never: leave it for an administrator to remove"
                }
            ]
        },
        {
            "key": "adif-cleanup-weekday",
            "name": "Day of the week",
